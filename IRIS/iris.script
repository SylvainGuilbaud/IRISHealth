
    set step="Install IPM"
    set r=##class(%Net.HttpRequest).%New(),r.Server="pm.community.intersystems.com",r.SSLConfiguration="ISC.FeatureTracker.SSL.Config" d r.Get("/packages/zpm/latest/installer"),$system.OBJ.LoadStream(r.HttpResponse.Data,"c")
    if 'sc { set ^["USER"]TRACE($zdt($now(),3,,6),step)=$lb($system.Status.GetErrorCodes(sc),$system.Status.GetErrorText(sc))} else { set ^["USER"]TRACE($zdt($now(),3,,6),step)="successful"}
    zpm "repo -r -n registry -reset-defaults"
    zpm "install webterminal"
    zpm "install classexplorer" 
    zpm "install passwordless"
    zpm "install fhir-portal"
    zpm "install swagger-ui"
    zpm "install csvgen"
    zpm "install readonly-interoperability"
    zpm "enable -map -globally"

    zn "%SYS"
    do ##class(%SQL.Statement).%ExecDirect(,"update security.events set enabled=1")

    do ##class(Security.SSLConfigs).Create("API")
    do ##class(Security.Applications).Import("/home/irisowner/dev/webapp.xml",.n) 

    zn "IRISAPP"

    #; common
    do $system.OBJ.Import("/home/irisowner/dev/src/inc/common.inc","ck")

    #; HL7v2
    write ##class(EnsLib.HL7.SchemaXML).Import("/home/irisowner/dev/src/HL7v2/GEFI.HL7")
    write ##class(EnsLib.HL7.SchemaXML).Import("/home/irisowner/dev/src/HL7v2/GEFIReceiver.HL7")
    write ##class(EnsLib.HL7.SchemaXML).Import("/home/irisowner/dev/src/HL7v2/HL7v25IHE.HL7")
    write ##class(EnsLib.HL7.SchemaXML).Import("/home/irisowner/dev/src/HL7v2/HL7v231IHE.HL7")
    write ##class(EnsLib.HL7.SchemaXML).Import("/home/irisowner/dev/src/HL7v2/HPRIMV2.HL7")

    #; HPRIM
    do $system.OBJ.Import("/home/irisowner/dev/src/HPRIME1238.inc","ck")
    do $system.OBJ.Import("/home/irisowner/dev/src/HPRIME1238Errors.inc","ck")

    set sc = $SYSTEM.OBJ.Import("/home/irisowner/dev/src","ck",,1)

    write ##class(EnsLib.EDI.ASTM.SchemaXML).Import("/home/irisowner/dev/src/HPRIM2.2.AST")
    write ##class(EnsLib.EDI.ASTM.SchemaXML).Import("/home/irisowner/dev/src/HPRIM2.2Add.AST")
    write ##class(HPRIM.EDI.E1238.SchemaXML).Import("/home/irisowner/dev/src/HPRIM2.2.AST")
    write ##class(HPRIM.EDI.E1238.SchemaXML).Import("/home/irisowner/dev/src/HPRIM2.2Add.AST")

    #; HPRIMXML 2.4
    set step="Importing HPRIM XML 2.4"
    set sc = ##class(EnsLib.EDI.XML.SchemaXSD).ImportFiles("/home/irisowner/dev/src/HPRIMXML/schemaHprimV2_4/")
    if 'sc { set ^["USER"]TRACE($zdt($now(),3,,6),step)=$lb($system.Status.GetErrorCodes(sc),$system.Status.GetErrorText(sc))} else { set ^["USER"]TRACE($zdt($now(),3,,6),step)="successful"}

    do ##class(Ens.Util.Statistics).EnableSAMForNamespace()
    do ##class(Ens.Util.Statistics).EnableStatsForProduction()

    #; Credentials    
    write ##class(Ens.Config.Credentials).SetCredential("ftp","app","youneverknow",1)
    write ##class(Ens.Config.Credentials).SetCredential("PostgreSQL","postgres","postgres",1)

    #; WorkFlow    
    Do ##class(EnsLib.Workflow.RoleDefinition).CreateRole("ManualBloodPressureRole") 
    Do ##class(EnsLib.Workflow.RoleDefinition).CreateRole("AutomaticBloodPressureRole") 
    Do ##class(EnsLib.Workflow.RoleDefinition).CreateRole("cellule identito-vigilance")
    do ##class(Workflow.Utils.Functions).UserExists("FakeDoctor","ManualBloodPressureRole") 
    do ##class(Workflow.Utils.Functions).UserExists("Virgile","cellule identito-vigilance") 

    #; Lookup table
    do ##class(Ens.Util.LookupTable).%Import("/home/irisowner/dev/src/gbl/gender.xml")

    #; zpm "install csvgen"
    Do ##class(community.csvgen).Generate("/home/irisowner/dev/ML/heart-disease.csv",",","dc.data.health.HeartDisease") 
    Do ##class(community.csvgen).Generate("/home/irisowner/dev/ML/breast-cancer.csv",",","dc.data.health.BreastCancer") 
    Do ##class(community.csvgen).Generate("/home/irisowner/dev/ML/diabetes.csv",",","dc.data.health.Diabetes")  
    Do ##class(community.csvgen).Generate("/home/irisowner/dev/ML/kidney_disease.csv",",","dc.data.health.KidneyDisease") 
    Do ##class(community.csvgen).Generate("/home/irisowner/dev/ML/maternal_health_risk.csv",",","dc.data.health.MaternalHealthRisk") 
    Do ##class(community.csvgen).Generate("/home/irisowner/dev/ML/hospital_mortality.csv",",","dc.data.health.HospitalMortality") 
    Do ##class(community.csvgen).Generate("/home/irisowner/dev/ML/life_expectancy.csv",",","dc.data.health.LifeExpectancy") 
    Do ##class(community.csvgen).Generate("/home/irisowner/dev/ML/pollution-deaths-from-fossil-fuels.csv",",","dc.data.health.PollutionDeaths") 
    Do ##class(community.csvgen).Generate("/home/irisowner/dev/ML/dementia.csv",",","dc.data.health.Dementia") 
    Do ##class(community.csvgen).Generate("/home/irisowner/dev/ML/hepatitis.csv",",","dc.data.health.Hepatitis") 
    
    zn "%SYS"
    set demo("NameSpace") = "IRISAPP"
    set demo("DispatchClass") = "IRISHealth.REST"
    set demo("CookiePath") = "/csp/demo/rest/"
    set demo("Description") = "Demo REST API"
    set demo("MatchRoles") = ":%All"
    set demo("AutheEnabled") = 64
    set demo("IsNameSpaceDefault") = 0
    set tSC = ##class(Security.Applications).Create("/csp/demo/rest", .demo)

    set crud("NameSpace") = "IRISAPP"
    set crud("DispatchClass") = "IRISHealth.REST"
    set crud("CookiePath") = "/crud/"
    set crud("Description") = "CRUD REST API"
    set crud("MatchRoles") = ":%All"
    set crud("AutheEnabled") = 96
    set crud("IsNameSpaceDefault") = 0
    set tSC = ##class(Security.Applications).Create("/crud", .crud)

    set mainapp="/csp/healthshare/irisapp"
    set prop("DeepSeeEnabled")=1
    set prop("IsNameSpaceDefault")=1
    set sc = ##class(Security.Applications).Modify(mainapp,.prop)

    set webName = "/common"    
    set webProperties("DispatchClass") = "common.REST"
    set webProperties("NameSpace") = "IRISAPP"
    set webProperties("Enabled") = 1
    set webProperties("AutheEnabled") = 96
    set webProperties("MatchRoles")=":%All"
    set sc = ##class(Security.Applications).Create(webName, .webProperties)

    zn "IRISAPP"

    do ##class(%File).CopyFile("/home/irisowner/dev/fhirPortal/myFHIR.js","/usr/irissys/csp/fhir/portal/resources/js/myFHIR.js")

    do ##class(%File).CopyFile("/home/irisowner/dev/swagger-ui/index.html","/usr/irissys/csp/swagger-ui/index.html")

    do ##class(%File).CopyFile("/home/irisowner/dev/wkhtmltopdf/wkhtmltopdf","/usr/local/bin/wkhtmltopdf")

    set ^EnsPortal.SavedSearchD("Date de naissance")=$lb("",$lb("3",2,"",999,"","","","","","","","","","",$lb($lb($lb($lb($lb($lb("IF","=",19721201,"2.5.1:[PID:DateTimeOfBirth]",0))),0,"EnsLib.HL7.Message","VDocSegment"))),""),"SuperUser","2024-06-25 20:59:30.506","2024-06-25 21:00:34.822","SuperUser")
    set ^EnsPortal.SavedSearchD("PRENOM et SEXE = Camille F")=$lb("",$lb(0,2,"",999,"","","","","","","","","","",$lb($lb($lb($lb($lb($lb("IF","=","Camille","2.5.1:[PID:PatientName().givenname]",0))),0,"EnsLib.HL7.Message","VDocSegment")),$lb($lb($lb($lb($lb("IF","=","F","2.5.1:ADT_A01:{PID:AdministrativeSex}",0))),0,"EnsLib.HL7.Message","VDocPath"))),""),"SuperUser","2024-07-11 16:12:27.559","2024-07-15 16:00:38.022","SuperUser")
    set ^EnsPortal.SavedSearchD("Date de naissance 19xxx")=$lb("",$lb(3,2,"",999,"","","","","","","","","","",$lb($lb($lb($lb($lb($lb("IF","StartsWith","19","2.5.1:[PID:DateTimeOfBirth]",0))),0,"EnsLib.HL7.Message","VDocSegment"))),""),"SuperUser","2024-07-15 16:06:50.957","2024-07-15 16:06:50.957","SuperUser")

    do ##class(community.csvgen).Generate("/home/irisowner/dev/data/csv/titanic.csv",,"data.TitanicPassenger")

    Set ^Ens.Debug("UtilEnsMessages","sql")=1

    set ^Ens.Config.DefaultSettingsD("*","*","*","AlertOnError")=$lb("1","",0)
    set ^Ens.Config.DefaultSettingsD("*","*","*","ArchiveIO")=$lb("1","",0)
    set ^Ens.Config.DefaultSettingsD("*","*","*","LogTraceEvents")=$lb("0","",0)
    set ^Ens.Config.DefaultSettingsD("*","*","*","RuleLogging")=$lb("a","",0)
    set ^Ens.Config.DefaultSettingsD("*","from Lab TCP","*","Port")=$lb("19000","",0)
    set ^Ens.Config.DefaultSettingsD("*","to LAB TCP","*","Port")=$lb("19000","",0)
    set ^Ens.Config.DefaultSettingsD("IRISHealth.production","*","*","MessageSchemaCategory")=$lb("2.3.1","",0)
    set ^Ens.Config.DefaultSettingsD("IRISHealth.production","*","EnsLib.Kafka.Service","Servers")=$lb("host.docker.internal:9092","",0)
    set ^Ens.Config.DefaultSettingsD("IRISHealth.production","*","EnsLib.Kafka.Service","TargetConfigNames")=$lb("Kafka router","",0)
    set ^Ens.Config.DefaultSettingsD("IRISHealth.production","*","EnsLib.SQL.Operation.GenericOperation","DSN")=$lb("iris","",0)
    set ^Ens.Config.DefaultSettingsD("IRISHealth.production","*","EnsLib.SQL.Operation.GenericOperation","JGService")=$lb("JDBC Gateway","",0)
    set ^Ens.Config.DefaultSettingsD("IRISHealth.production","*","EnsLib.SQL.Operation.GenericOperation","RequestClass")=$lb("EnsLib.Kafka.Message","",0)
    set ^Ens.Config.DefaultSettingsD("IRISHealth.production","*","EnsLib.SQL.Operation.GenericOperation","ResponseClass")=$lb("IRISHealth.msg.iris"_$c(2,1),0)
    set ^Ens.Config.DefaultSettingsD("IRISHealth.production","JDBC Gateway","*","Address")=$lb("127.0.0.1","",0)
    set ^Ens.Config.DefaultSettingsD("IRISHealth.production","JDBC Gateway","*","Port")=$lb("55555","",0)
    set ^Ens.Config.DefaultSettingsD("IRISHealth.production","source HL7 FILE","*","ArchivePath")=$lb("/data/HL7/archive","",0)
    set ^Ens.Config.DefaultSettingsD("IRISHealth.production","source HL7 FILE","*","FilePath")=$lb("/data/HL7/in","",0)
    set ^Ens.Config.DefaultSettingsD("IRISHealth.production","source HL7 FILE","*","WorkPath")=$lb("/data/HL7/work","",0)
    set ^Ens.Config.DefaultSettingsD("IRISHealth.production","source HL7 FILE validate","*","ArchivePath")=$lb("/data/HL7/archive","",0)
    set ^Ens.Config.DefaultSettingsD("IRISHealth.production","source HL7 FILE validate","*","FilePath")=$lb("/data/HL7/validate","",0)
    set ^Ens.Config.DefaultSettingsD("IRISHealth.production","source HL7 FILE validate","*","WorkPath")=$lb("/data/HL7/work","",0)
    set ^Ens.Config.DefaultSettingsD("IRISHealth.production","source HL7 HTTP","*","Port")=$lb("19001","",0)
    set ^Ens.Config.DefaultSettingsD("IRISHealth.production","source HL7 TCP","*","Port")=$lb("2575","",0)
    set ^Ens.Config.DefaultSettingsD("IRISHealth.production","source Kafka Consumer TOPIC APT-FROM-DXPLANNING","*","Topic")=$lb("APT-FROM-DXPLANNING-ENVOIE-TO-PTAH--RECEPTION","",0)
    set ^Ens.Config.DefaultSettingsD("IRISHealth.production","source Kafka Consumer TOPIC APT-FROM-TRAKCARE","*","Topic")=$lb("APT-FROM-TRAKCARE-ENVOIE-TO-PTAH--RECEPTION","",0)
    set ^Ens.Config.DefaultSettingsD("IRISHealth.production","source Kafka Consumer TOPIC SURG","*","Topic")=$lb("SURG-FROM-SendingApp-SendingFac-TO-ReceivingApp--ReceivingFac","",0)
    set ^Ens.Config.DefaultSettingsD("IRISHealth.production","store gender","*","InputParameters")=$lb("*firstname,*value","",0)
    set ^Ens.Config.DefaultSettingsD("IRISHealth.production","store gender","*","Query")=$lb("insert into data.gender (firstname,value)  values  (?,?)","",0)
    set ^Ens.Config.DefaultSettingsD("IRISHealth.production","target HL7 HTTP","*","HTTPPort")=$lb("19001","",0)
    set ^Ens.Config.DefaultSettingsD("IRISHealth.production","target HL7 HTTP","*","HTTPServer")=$lb("localhost","",0)
    set ^Ens.Config.DefaultSettingsD("IRISHealth.production","target HL7 TCP","*","IPAddress")=$lb("localhost","",0)
    set ^Ens.Config.DefaultSettingsD("IRISHealth.production","target HL7 TCP","*","Port")=$lb("2575","",0)
    set ^Ens.Config.DefaultSettingsD("IRISHealth.production","target IRIS DxCare SQL","*","Query")=$lb("insert into data_kafka.DxCare  (topic,key,value)  values  (?,?,?)","",0)
    set ^Ens.Config.DefaultSettingsD("IRISHealth.production","target IRIS DxCare SQL","EnsLib.SQL.Operation.GenericOperation","InputParameters")=$lb("*topic,*key,*value","",0)
    set ^Ens.Config.DefaultSettingsD("IRISHealth.production","target IRIS Surg SQL","*","Query")=$lb("insert into data_kafka.Surg  (topic,key,value)  values  (?,?,?)","",0)
    set ^Ens.Config.DefaultSettingsD("IRISHealth.production","target IRIS Surg SQL","EnsLib.SQL.Operation.GenericOperation","InputParameters")=$lb("*topic,*key,*value","",0)
    set ^Ens.Config.DefaultSettingsD("IRISHealth.production","target IRIS TrakCare SQL","*","Query")=$lb("insert into data_kafka.TrakCare  (topic,key,value)  values  (?,?,?)","",0)
    set ^Ens.Config.DefaultSettingsD("IRISHealth.production","target IRIS TrakCare SQL","EnsLib.SQL.Operation.GenericOperation","InputParameters")=$lb("*topic,*key,*value","",0)
    set ^Ens.Config.DefaultSettingsD("IRISHealth.production","target Kafka Producer","*","Servers")=$lb("host.docker.internal:9092","",0)
    
    zpm "load /home/irisowner/dev/ -dev -v":1:1
    halt
