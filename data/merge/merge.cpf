[Startup]
SystemMode=LIVE

[config]
globals=0,0,8192,0,0,0
routines=0
jrnbufs=1024

[Actions]

[Actions]
CreateResource:Name=%DB_APP_DATA,Description="APP_DATA database"
CreateDatabase:Name=APP_DATA,Directory=/volumes/IRIS/mgr/APP_DATA,Resource=%DB_APP_DATA
CreateResource:Name=%DB_APP_CODE,Description="APP_CODE database"
CreateDatabase:Name=APP_CODE,Directory=/volumes/IRIS/mgr/APP_CODE,Resource=%DB_APP_CODE
CreateNamespace:Name=APP,Globals=APP_DATA,Routines=APP_CODE,Interop=1

Execute:Namespace="APP",ClassName="%SYSTEM.OBJ",MethodName="Import",Arg1="/data/src",Arg2="ck"

CreateNamespace:Name=%ALL,Globals=IRISTEMP,Routines=IRISTEMP
CreateMapPackage:Namespace=%ALL,Name=common,Database=USER
CreateMapRoutine:Namespace=%ALL,Name=common,Database=USER

ModifyService:Name=%Service_CallIn,Enabled=1,AutheEnabled=48
ModifyUser:Name=SuperUser,PasswordHash=a31d24aecc0bfe560a7e45bd913ad27c667dc25a75cbfd358c451bb595b6bd52bd25c82cafaa23ca1dd30b3b4947d12d3bb0ffb2a717df29912b743a281f97c1,0a4c463a2fa1e7542b61aa48800091ab688eb0a14bebf536638f411f5454c9343b9aa6402b4694f0a89b624407a5f43f0a38fc35216bb18aab7dc41ef9f056b1,10000,SHA512

; === ES1 ===
CreateResource:Name=%DB_ES1_CODE,Description="Base routines ES1"
CreateDatabase:Name=ES1_CODE,Directory=/volumes/IRIS/mgr/ES1_code,Resource=%DB_ES1_CODE

CreateResource:Name=%DB_ES1_DATA,Description="Base globales ES1"
CreateDatabase:Name=ES1_DATA,Directory=/volumes/IRIS/mgr/ES1_data,Resource=%DB_ES1_DATA

CreateNamespace:Name=ES1,Globals=ES1_DATA,Routines=ES1_CODE,Interop=1

; === ES2 ===
CreateResource:Name=%DB_ES2_CODE,Description="Base routines ES2"
CreateDatabase:Name=ES2_CODE,Directory=/volumes/IRIS/mgr/ES2_code,Resource=%DB_ES2_CODE

CreateResource:Name=%DB_ES2_DATA,Description="Base globales ES2"
CreateDatabase:Name=ES2_DATA,Directory=/volumes/IRIS/mgr/ES2_data,Resource=%DB_ES2_DATA

CreateNamespace:Name=ES2,Globals=ES2_DATA,Routines=ES2_CODE,Interop=1

; === ES3 ===
CreateResource:Name=%DB_ES3_CODE,Description="Base routines ES3"
CreateDatabase:Name=ES3_CODE,Directory=/volumes/IRIS/mgr/ES3_code,Resource=%DB_ES3_CODE

CreateResource:Name=%DB_ES3_DATA,Description="Base globales ES3"
CreateDatabase:Name=ES3_DATA,Directory=/volumes/IRIS/mgr/ES3_data,Resource=%DB_ES3_DATA

CreateNamespace:Name=ES3,Globals=ES3_DATA,Routines=ES3_CODE,Interop=1

; === ES4 ===
CreateResource:Name=%DB_ES4_CODE,Description="Base routines ES4"
CreateDatabase:Name=ES4_CODE,Directory=/volumes/IRIS/mgr/ES4_code,Resource=%DB_ES4_CODE

CreateResource:Name=%DB_ES4_DATA,Description="Base globales ES4"
CreateDatabase:Name=ES4_DATA,Directory=/volumes/IRIS/mgr/ES4_data,Resource=%DB_ES4_DATA

CreateNamespace:Name=ES4,Globals=ES4_DATA,Routines=ES4_CODE,Interop=1

; === ES5 ===
CreateResource:Name=%DB_ES5_CODE,Description="Base routines ES5"
CreateDatabase:Name=ES5_CODE,Directory=/volumes/IRIS/mgr/ES5_code,Resource=%DB_ES5_CODE

CreateResource:Name=%DB_ES5_DATA,Description="Base globales ES5"
CreateDatabase:Name=ES5_DATA,Directory=/volumes/IRIS/mgr/ES5_data,Resource=%DB_ES5_DATA

CreateNamespace:Name=ES5,Globals=ES5_DATA,Routines=ES5_CODE,Interop=1

; === Rôles et droits associés ===
CreateRole:Name=Writer_ES1,Resources=%DB_ES1_DATA:RW,%DB_ES1_CODE:RW
CreateRole:Name=Reader_ES1,Resources=%DB_ES1_DATA:R,%DB_ES1_CODE:R

CreateRole:Name=Writer_ES2,Resources=%DB_ES2_DATA:RW,%DB_ES2_CODE:RW
CreateRole:Name=Reader_ES2,Resources=%DB_ES2_DATA:R,%DB_ES2_CODE:R

CreateRole:Name=Writer_ES3,Resources=%DB_ES3_DATA:RW,%DB_ES3_CODE:RW
CreateRole:Name=Reader_ES3,Resources=%DB_ES3_DATA:R,%DB_ES3_CODE:R

CreateRole:Name=Writer_ES4,Resources=%DB_ES4_DATA:RW,%DB_ES4_CODE:RW
CreateRole:Name=Reader_ES4,Resources=%DB_ES4_DATA:R,%DB_ES4_CODE:R

CreateRole:Name=Writer_ES5,Resources=%DB_ES5_DATA:RW,%DB_ES5_CODE:RW
CreateRole:Name=Reader_ES5,Resources=%DB_ES5_DATA:R,%DB_ES5_CODE:R

