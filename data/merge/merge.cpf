[Actions]

CreateResource:Name=%DB_APP_DATA,Description="APP_DATA database"
CreateDatabase:Name=APP_DATA,Directory=/volumes/IRIS/mgr/APP_DATA,Resource=%DB_APP_DATA
CreateResource:Name=%DB_APP_CODE,Description="APP_CODE database"
CreateDatabase:Name=APP_CODE,Directory=/volumes/IRIS/mgr/APP_CODE,Resource=%DB_APP_CODE
CreateNamespace:Name=APP,Globals=APP_DATA,Routines=APP_CODE,Interop=1

Execute:Namespace="APP",ClassName="%SYSTEM.OBJ",MethodName="Import",Arg1="/data/src",Arg2="ck"
